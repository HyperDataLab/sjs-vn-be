PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Cache Connections (PostgreSQL & Redis)
DATABASE_URL="postgresql://postgres:postgres123@100.121.61.95:5432/researchpulse?schema=public"
POSTGRES_URL="postgresql://postgres:postgres123@100.121.61.95:5432/researchpulse?schema=public"
REDIS_URL="redis://100.121.61.95:6379"

# Database Connection Pooling Options
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000
DB_POOL_MAX_USES=7500
PRISMA_POOL_MAX=10
PRISMA_POOL_TIMEOUT_SECONDS=10

# Cache Warmup Control
CACHE_ENABLED=true
CACHE_WARMUP_ENABLED=false

# Central ResearchPulse SSO
# The API URL is used for server-to-server calls. In Docker it can be an
# internal network alias while the issuer remains the browser-facing URL.
CENTRAL_SSO_API_URL=http://localhost:3001
CENTRAL_SSO_ISSUER_URL=http://localhost:3001
CENTRAL_SSO_TIMEOUT_MS=5000
SSO_CLIENT_ID=demo-client-app
SSO_REDIRECT_URI=http://localhost:5173/auth/callback

# Child-session signing secrets
VN_JWT_SECRET=replace-with-a-secret
VN_JWT_REFRESH_SECRET=replace-with-a-secret
# Optional: only needed when cleaning up old parent-cookie sessions
VN_SSO_BLOCK_SECRET=replace-with-a-secret

# Cloudflare Worker & Firebase Storage
CLOUDFLARE_WORKER_URL=http://localhost:8787
FIREBASE_STORAGE_BUCKET=scientificjournalsystem.appspot.com
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or pass full service account JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional storage tuning (defaults shown)
STORAGE_UPLOAD_EXPIRES_SECONDS=900
STORAGE_READ_EXPIRES_SECONDS=3600
STORAGE_MAX_ARTICLE_SIZE_BYTES=52428800
STORAGE_MAX_AVATAR_SIZE_BYTES=5242880
STORAGE_MAX_REPORT_SIZE_BYTES=26214400

# HTTP Response Compression & API Rate Limiting
COMPRESSION_THRESHOLD=1024
RATE_LIMIT_MAX=200
RATE_LIMIT_TIME_WINDOW="1 minute"
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW="1 minute"
